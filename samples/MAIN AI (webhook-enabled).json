    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Shrink the exported flow and hide secrets before sending it to the LLM\nconst wf = $json.data ?? $json;\nconst SENSITIVE = /(api[-_]?key|token|secret|password|authorization|bearer)/i;\n\nconst redact = (v) => {\n  if (Array.isArray(v)) return v.map(redact);\n  if (v && typeof v === 'object') {\n    const nameIsSecret = typeof v.name === 'string' && SENSITIVE.test(v.name);\n    return Object.fromEntries(\n      Object.entries(v).map(([k, val]) => [\n        k,\n        SENSITIVE.test(k) || (nameIsSecret && k === 'value') ? '[REDACTED]' : redact(val),\n      ])\n    );\n  }\n  if (\n    typeof v === 'string' &&\n    (/^\\s*(bearer|basic)\\s+\\S+/i.test(v) || /\\b(sk-|xox[a-z]-|ghp_|AIza)[A-Za-z0-9_-]{16,}/.test(v))\n  ) {\n    return '[REDACTED]';\n  }\n  return v;\n};\n\n// Same name that was used to compare against the sheet (file name without .json)\nconst sheetName = $('Find Missing Flows2').item.json['Flow Name'];\n\nconst compact = {\n  name: wf.name,\n  nodes: (wf.nodes || []).map((n) => ({\n    name: n.name,\n    type: n.type,\n    typeVersion: n.typeVersion,\n    disabled: n.disabled || false,\n    notes: n.notes,\n    credentials: Object.entries(n.credentials || {}).map(([type, c]) => ({ type, name: c && c.name })),\n    parameters: redact(n.parameters),\n  })),\n  connections: wf.connections,\n};\n\nreturn {\n  json: {\n    flowName: sheetName,\n    flowId: wf.id ?? '',\n    flowJson: JSON.stringify(compact),\n  },\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1360,
        192
      ],
      "id": "69badfb7-8d6c-49f5-bb14-6ed80ab0ca00",
      "name": "Prepare Flow For LLM1"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://compass.llm.shopee.io/compass-api/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: 'compass-max',\n  temperature: 0.2,\n  messages: [\n    {\n      role: 'system',\n      content: [\n        'You are an expert n8n engineer and technical writer. You receive one exported n8n workflow as JSON.',\n        'Reply in exactly two parts, separated by a line that contains only ===DOC===',\n        'PART 1 (before the separator): a small description of the flow in plain text, 1-2 sentences, max 250 characters, no label.',\n        'PART 2 (after the separator): full documentation as PLAIN TEXT for a Google Doc. Do not use HTML, markdown symbols (no #, no **) or code fences. Write each section title in UPPERCASE on its own line, followed by a blank line. Use numbered lines for ordered steps and lines starting with a dash for lists. For tables, write one dash line per row in the form: Node: X | Type: Y | What it does: Z.',\n        'PART 2 must contain these sections in this order: the flow name as a title; OVERVIEW; TRIGGER; STEP-BY-STEP FLOW (numbered, in execution order, using the node names); NODE REFERENCE (one line per node: Node | Type | What it does); CREDENTIALS TO CHANGE (one line per credential: Node | Credential type | Credential name in the export | What the user must do); VALUES TO CHANGE BEFORE USING (one line per item: Node | Parameter | Current value | What to change) covering hardcoded IDs, folder, sheet or file IDs, URLs, emails, chat or channel IDs, webhook paths, model names and any placeholder text; INPUTS AND OUTPUTS; RISKS AND TROUBLESHOOTING.',\n        'Values shown as [REDACTED] were secrets in the original flow, so list them as secrets that must be re-entered.',\n        'Do not invent anything. If something is unclear from the JSON, say so.'\n      ].join('\\n')\n    },\n    {\n      role: 'user',\n      content: 'Flow name: ' + $json.flowName + '\\n\\nWorkflow JSON (credentials are listed by type and name only, secrets are replaced with [REDACTED]):\\n' + $json.flowJson\n    }\n  ]\n}) }}",
        "options": {
          "timeout": 180000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1584,
        192
      ],
      "id": "12cc141b-1f8e-4852-9b87-ce598c835935",
      "name": "Send To Compass LLM1",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "9wJMmMyWuQTRCA1V",
          "name": "Header Auth account 19"
        }
      }
    },
