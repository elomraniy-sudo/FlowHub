    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Split the LLM answer into a small description and the full plain-text documentation\nconst prep = $('Prepare Flow For LLM1').item.json;\nconst raw = String($json.choices?.[0]?.message?.content ?? $json.output ?? '');\n\nconst clean = raw\n  .replace(/<think>[\\s\\S]*?<\\/think>/gi, '')\n  .replace(/```[a-z]*\\n?/gi, '')\n  .replace(/<\\/?[a-z][^>]*>/gi, '')\n  .replace(/\\*\\*/g, '')\n  .replace(/^#{1,6}\\s*/gm, '')\n  .trim();\n\nconst parts = clean.split(/^[ \\t]*={2,}\\s*DOC\\s*={2,}[ \\t]*$/im);\n\nlet description;\nlet docText;\nif (parts.length > 1) {\n  description = parts[0];\n  docText = parts.slice(1).join('\\n').trim();\n} else {\n  // The model ignored the separator: use everything as the doc and cut a short description\n  docText = clean;\n  description = clean.slice(0, 250);\n}\ndescription = description.replace(/\\s+/g, ' ').trim().replace(/^(small )?description:?\\s*/i, '').slice(0, 300);\n\nreturn {\n  json: {\n    flowName: prep.flowName,\n    flowId: prep.flowId,\n    title: `${prep.flowName} - Documentation`,\n    description,\n    docText,\n  },\n};"
      },
