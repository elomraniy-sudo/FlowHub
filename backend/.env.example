# --- LLM (Compass, OpenAI-compatible) ---
COMPASS_API_KEY=
COMPASS_BASE_URL=https://compass.llm.shopee.io/compass-api/v1
COMPASS_MODEL=compass-max
LLM_MOCK=false

# --- n8n (Settings > n8n API) ---
N8N_BASE_URL=https://n8n.your-company.com
N8N_API_KEY=

# "Run in n8n" button -> webhook of the FlowHub Runner workflow (samples/FlowHub Runner.json), production URL
N8N_RUN_WEBHOOK_URL=https://n8n.your-company.com/webhook/flowhub-run

# --- Google Drive / MAIN AI registry ---
# service_account (default): direct Google APIs; share the folders + sheet with the service account's client_email
GOOGLE_BACKEND=service_account
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json
# alternative: GOOGLE_BACKEND=n8n routes Google calls through samples/FlowHub Bridge.json
N8N_BRIDGE_URL=
GOOGLE_DRIVE_FOLDER_ID=1WzwOoFR_lBZqaST2ZN4F4f9ZwXZn6CdX   # "AI Project"  (n8n JSON exports)
GOOGLE_DOCS_FOLDER_ID=1mz3y3EkVInEnt0GOaggF6715qbVeKFhm    # "AI DOC"      (docs written by MAIN AI)
GOOGLE_SHEET_ID=1Cenq497IektpOrMDtyELOmE5cYsALmTMUo5j2m2EA44   # "All N8N Flows" registry
MAIN_AI_WEBHOOK_URL=        # e.g. https://n8n.company.com/webhook/flowhub-main-ai (webhook-enabled copy)
MAIN_AI_WORKFLOW_ID=        # id of MAIN AI in n8n (for the "open in n8n" link)
SYNC_INTERVAL_MINUTES=0     # e.g. 30 to pull the registry automatically

DATABASE_URL=sqlite:///./flowhub.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
